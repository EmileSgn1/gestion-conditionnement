<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="etat_stocks" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="26cb8830-4a7b-49d8-b3fd-1656210bb81a">
    <queryString language="SQL"><![CDATA[SELECT a.reference AS reference, a.nom AS article, s.quantite AS quantite, COALESCE(s.derniere_maj, s.date_modification) AS date_maj FROM stocks s JOIN articles a ON a.id = s.article_id ORDER BY a.nom]]></queryString>
    <field name="reference" class="java.lang.String"/><field name="article" class="java.lang.String"/><field name="quantite" class="java.math.BigDecimal"/><field name="date_maj" class="java.sql.Timestamp"/>
