<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="my_persistence_unit" transaction-type="JTA">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <jta-data-source>java:jboss/datasources/gestion_conditionnement_db</jta-data-source>
    
    <!-- Entités du projet -->
    <class>Entities.Alertes</class>
    <class>Entities.ArticleConditionnements</class>
    <class>Entities.Articles</class>
    <class>Entities.Categories</class>
    <class>Entities.CompositionsConditionnements</class>
    <class>Entities.Conditionnements</class>
    <class>Entities.ConditionnementsCatalogue</class>
    <class>Entities.EcartsStock</class>
    <class>Entities.Historique</class>
    <class>Entities.HistoriqueActions</class>
    <class>Entities.MouvementsStock</class>
    <class>Entities.Notifications</class>
    <class>Entities.OperationsConditionnement</class>
    <class>Entities.Parametres</class>
    <class>Entities.ParametresApplication</class>
    <class>Entities.Roles</class>
    <class>Entities.Stocks</class>
    <class>Entities.TypesConditionnement</class>
    <class>Entities.Unites</class>
    <class>Entities.Utilisateurs</class>

    <properties>
      <!-- Stratégie de génération des tables -->
      <property name="eclipselink.ddl-generation" value="none"/>
    </properties>
  </persistence-unit>
</persistence>
