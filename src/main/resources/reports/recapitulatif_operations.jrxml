<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="recapitulatif_operations" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail" uuid="bdc44c7c-2c9d-414c-972c-50bb5c5e94b7">
    <queryString language="SQL"><![CDATA[SELECT o.reference AS reference, o.date_operation AS date_operation, src.nom AS article_source, dst.nom AS article_produit, o.quantite_consommee AS quantite_consommee, o.quantite_produite AS quantite_produite, u.email AS utilisateur FROM operations_conditionnement o LEFT JOIN articles src ON src.id = o.article_source_id LEFT JOIN articles dst ON dst.id = o.article_produit_id LEFT JOIN utilisateurs u ON u.id = o.utilisateur_id ORDER BY o.date_operation DESC]]></queryString>
    <field name="reference" class="java.lang.String"/><field name="date_operation" class="java.sql.Timestamp"/><field name="article_source" class="java.lang.String"/><field name="article_produit" class="java.lang.String"/><field name="quantite_consommee" class="java.math.BigDecimal"/><field name="quantite_produite" class="java.math.BigDecimal"/><field name="utilisateur" class="java.lang.String"/>
    <title><band height="42"><staticText><reportElement x="0" y="5" width="782" height="30"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><text><![CDATA[Récapitulatif des opérations de conditionnement]]></text></staticText></band></title>
    <columnHeader><band height="25"><staticText><reportElement x="0" y="0" width="95" height="22"/><text><![CDATA[Référence]]></text></staticText><staticText><reportElement x="95" y="0" width="105" height="22"/><text><![CDATA[Date]]></text></staticText><staticText><reportElement x="200" y="0" width="145" height="22"/><text><![CDATA[Article source]]></text></staticText><staticText><reportElement x="345" y="0" width="145" height="22"/><text><![CDATA[Article produit]]></text></staticText><staticText><reportElement x="490" y="0" width="90" height="22"/><text><![CDATA[Consommée]]></text></staticText><staticText><reportElement x="580" y="0" width="90" height="22"/><text><![CDATA[Produite]]></text></staticText><staticText><reportElement x="670" y="0" width="112" height="22"/><text><![CDATA[Utilisateur]]></text></staticText></band></columnHeader>
    <detail><band height="22"><textField><reportElement x="0" y="0" width="95" height="20"/><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy"><reportElement x="95" y="0" width="105" height="20"/><textFieldExpression><![CDATA[$F{date_operation}]]></textFieldExpression></textField><textField><reportElement x="200" y="0" width="145" height="20"/><textFieldExpression><![CDATA[$F{article_source}]]></textFieldExpression></textField><textField><reportElement x="345" y="0" width="145" height="20"/><textFieldExpression><![CDATA[$F{article_produit}]]></textFieldExpression></textField><textField pattern="#,##0.###"><reportElement x="490" y="0" width="90" height="20"/><textFieldExpression><![CDATA[$F{quantite_consommee}]]></textFieldExpression></textField><textField pattern="#,##0.###"><reportElement x="580" y="0" width="90" height="20"/><textFieldExpression><![CDATA[$F{quantite_produite}]]></textFieldExpression></textField><textField><reportElement x="670" y="0" width="112" height="20"/><textFieldExpression><![CDATA[$F{utilisateur}]]></textFieldExpression></textField></band></detail>
